# Copy this file to `.env` and fill in the values for your Supabase project.
# `.env` is gitignored — never commit real credentials.
#
# Both values are safe to expose in the client bundle: the anon key is designed
# to be public, and access is controlled by row-level security policies on the
# database. Never put the service-role key here — it bypasses RLS and must only
# ever live in server-side code (e.g. Edge Functions).
#
# Find these in the Supabase dashboard under Project Settings -> API.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Optional: only needed for Google Maps tiles on Android. Leave blank to run
# on iOS / Expo Go — app.config.js will warn and skip the native maps config
# so teammates don't need to edit map.tsx.
GOOGLE_MAPS_ANDROID_API_KEY=
